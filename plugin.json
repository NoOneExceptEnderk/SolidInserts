{
  "id": "solidinserts",
  "name": "SolidInserts",
  "version": "1.1.0",
  "description": "Create seats for heat-set threaded inserts at the circular rims of existing holes.",
  "capabilities": ["commands@0.1"],
  "runtime": {
    "module": "plugin.wasm",
    "entries": [
      {
        "name": "applica",
        "effect": "edit",
        "slots": [
          {"kind": "menu", "name": "Insert Seats"},
          {"kind": "ribbon", "name": "Insert Seats"}
        ],
        "input_schema": {
          "type": "object",
          "x-solidinserts-select-holes": 2,
          "x-solidinserts-locale": true,
          "required": ["serie", "filettatura"],
          "properties": {
            "serie": {
              "type": "string",
              "title": "Type",
              "description": "Short Version for M3, M4 and M5. VORON M3 × 5 × 4 for M3.",
              "enum": ["Standard", "Short Version", "VORON M3 × 5 × 4"],
              "default": "Standard"
            },
            "filettatura": {
              "type": "string",
              "title": "Screw thread",
              "description": "Automatic matches the nominal hole diameter within ±0.05 mm. For clearance holes, choose the screw size.",
              "enum": ["Automatic (nominal Ø)", "M2 × 0,40", "M2,5 × 0,45", "M3 × 0,50", "M4 × 0,70", "M5 × 0,80", "M6 × 1,00", "M8 × 1,25", "M10 × 1,50"],
              "default": "Automatic (nominal Ø)"
            },
            "compensazione_mm": {
              "type": "number",
              "title": "Diameter compensation",
              "description": "Adjustment to the seat diameter. Use 0 for the catalog dimension.",
              "unit": "mm",
              "default": 0,
              "minimum": -1,
              "maximum": 1,
              "multipleOf": 0.01
            }
          }
        }
      }
    ],
    "commands": [
      "document.inspect",
      "model.edges",
      "model.faces",
      "inspect.measure",
      "sketch.create",
      "sketch.project",
      "sketch.inspect",
      "sketch.circle.center",
      "sketch.dimension",
      "sketch.finish",
      "solid.extrude",
      "select.clear"
    ],
    "limits": {"fuel": 100000000, "memory_mib": 64, "deadline_ms": 30000}
  }
}
