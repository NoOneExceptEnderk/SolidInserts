+                let i = *index as usize;
+                if let (Some(p), Some(n)) = (mesh.positions.get(i), mesh.normals.get(i)) {
+                    scene.xray_tri(p.to_f32(), n.to_f32(), tint);
+                }
+            }
+        }
+    }
