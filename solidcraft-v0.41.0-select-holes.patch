+struct Preview {
+    edit: ComputedCommands,
+    seats: Vec<Seat>,
+    meshes: Vec<Mesh>,
+    bounds: Aabb3,
+    key: u64,
+    label: String,
+}
+
+struct Seat {
+    center: Vec3,
+    normal: Vec3,
+    pilot_radius: f64,
+    pilot_depth: f64,
+    radius: f64,
+    depth: f64,
+}
+
+/// Draw a representative M3 insert at the same scale for all three series.
+pub(crate) fn insert_illustration(ui: &mut Ui, series: &str) {
+    let (photo, render) = match series {
+        "Standard" => ("standard", include_bytes!("../../../assets/solidinserts/standard.png").as_slice()),
+        "Short Version" | "Corto" => ("short", include_bytes!("../../../assets/solidinserts/short.png").as_slice()),
+        "VORON M3 × 5 × 4" | "Voron" => ("voron", include_bytes!("../../../assets/solidinserts/voron.png").as_slice()),
+        _ => return,
+    };
+    let (rect, _) = ui.allocate_exact_size(vec2(96.0, 72.0), egui::Sense::hover());
+    if let Some(texture) = insert_photo(ui.ctx(), photo, render) {
+        let size = texture.size_vec2() * (rect.height() / texture.size_vec2().y);
+        ui.painter().image(
+            texture.id(),
+            Rect::from_center_size(rect.center(), size),
+            Rect::from_min_max(Pos2::ZERO, egui::pos2(1.0, 1.0)),
+            egui::Color32::WHITE,
+        );
+    }
+}
+
+/// Prefer the user's local reference photo, then the original bundled render.
+fn insert_photo(ctx: &Context, series: &str, render: &[u8]) -> Option<egui::TextureHandle> {
+    let key = egui::Id::unique(("solidinserts-local-photo", series));
+    if let Some(cached) = ctx.data_mut(|data| data.get_temp::<Option<egui::TextureHandle>>(key)) {
+        return cached;
+    }
+    let image = local_insert_photo(series)
+        .or_else(|| image::load_from_memory_with_format(render, image::ImageFormat::Png).ok().map(|image| image.into_rgba8()));
+    let texture = image.map(|image| {
+        let size = [image.width() as usize, image.height() as usize];
+        let pixels = egui::ColorImage::from_rgba_unmultiplied(size, image.as_raw());
+        ctx.load_texture(format!("solidinserts-photo-{series}"), pixels, egui::TextureOptions::LINEAR)
+    });
+    ctx.data_mut(|data| data.insert_temp(key, texture.clone()));
+    texture
+}
+
+fn local_insert_photo(series: &str) -> Option<image::RgbaImage> {
+    let path = solidcraft_engine::recovery::data_dir()?.join("solidinserts-photos").join(format!("{series}.png"));
+    let file = std::fs::File::open(path).ok()?;
+    if file.metadata().ok()?.len() > 8 * 1024 * 1024 {
+        return None;
+    }
+    let mut reader = image::ImageReader::with_format(std::io::BufReader::new(file), image::ImageFormat::Png);
+    let mut limits = image::Limits::default();
+    limits.max_image_width = Some(2000);
+    limits.max_image_height = Some(2000);
+    limits.max_alloc = Some(24 * 1024 * 1024);
+    reader.limits(limits);
+    let image = reader.decode().ok()?;
+    // The catalogue images use a common frame. Crop to the standing insert at right.
+    let span = image.width().min(image.height());
+    let scale = |fraction: u32| span * fraction / 1000;
+    let cropped = image.crop_imm(scale(515), scale(475), scale(310), scale(391));
+    Some(cropped.resize_exact(114, 144, image::imageops::FilterType::Lanczos3).into_rgba8())
+}
+
+pub(crate) fn can_pick(app: &SolveApp) -> bool {
+    !cfg!(target_arch = "wasm32")
+        && !app.home.open
+        && !app.session.read_only
+        && app.session.active_sketch.is_none()
+        && app.session.doc.marker.is_none()
+        && app.tool.is_none()
+        && app.dialog.is_none()
+        && !app.file_load_holds()
+        && app.file_picker.is_none()
+        && app.saving.is_none()
+        && app.control_job.is_none()
+        && !app.agent.busy()
+        && !crate::render_workspace::active(app)
+}
+
+pub(crate) fn active(app: &SolveApp) -> bool {
+    app.plugin_menu.dialog.as_ref().and_then(|dialog| dialog.holes.as_ref()).is_some_and(|mode| mode.picking && mode.in_design(app) && can_pick(app))
+}
+
+impl Mode {
+    pub(crate) fn new(app: &SolveApp) -> Self {
+        Self {
+            document: app.session.uid,
+            revision: app.session.revision,
+            picking: true,
+            selected: Vec::new(),
+            input: None,
+            pending: None,
+            preview: None,
+        }
+    }
+
+    pub(crate) fn in_design(&self, app: &SolveApp) -> bool {
+        self.document == app.session.uid
+    }
+
+    fn invalidate(&mut self) {
+        self.preview = None;
+        if let Some(pending) = &self.pending {
+            pending.progress.cancel();
+        }
+    }
+
+    fn select(&mut self, target: Target, extend: bool, limit: &str) -> Result<(), String> {
+        let existing = self.selected.iter().position(|picked| *picked == target);
+        if !extend {
+            if existing.is_some() && self.selected.len() == 1 {
+                return Ok(());
+            }
+            self.selected.clear();
+            self.selected.push(target);
+        } else if let Some(index) = existing {
+            self.selected.remove(index);
+        } else if self.selected.len() == MAX_HOLES {
+            return Err(limit.to_owned());
+        } else {
+            self.selected.push(target);
+        }
+        self.invalidate();
+        Ok(())
+    }
+
+    fn sync(&mut self, app: &SolveApp, input: Option<&Value>) {
+        if self.revision != app.session.revision {
+            self.selected.clear();
+            self.revision = app.session.revision;
+            self.invalidate();
+        }
+        if self.input.as_ref() != input {
+            self.input = input.cloned();
+            self.invalidate();
+        }
+        if let Some(Ok(preview)) = &self.preview
+            && !preview.edit.is_current(&app.session)
+        {
+            self.invalidate();
+        }
+    }
+
+    fn poll(&mut self, missing: &str, ctx: &Context) {
+        let Some(pending) = &self.pending else { return };
+        let reply = match pending.reply.try_recv() {
+            Ok(reply) => reply,
+            Err(mpsc::TryRecvError::Empty) => return,
+            Err(mpsc::TryRecvError::Disconnected) => Err(missing.into()),
+        };
+        if !pending.progress.is_cancelled() {
+            self.preview = Some(reply);
+            ctx.request_repaint();
+        }
+        self.pending = None;
+    }
+
+    pub(crate) fn ready(&self, app: &SolveApp, input: &Value) -> bool {
+        self.in_design(app)
+            && self.revision == app.session.revision
+            && can_pick(app)
+            && self.input.as_ref() == Some(input)
+            && matches!(&self.preview, Some(Ok(preview)) if preview.edit.is_current(&app.session))
+    }
+
+    pub(crate) fn status(&self, app: &SolveApp, ui: &mut Ui) {
+        let (text, tone) = if !can_pick(app) {
+            (app.tr("ui.plugin_holes_model"), StatusTone::Dim)
+        } else if self.selected.is_empty() {
+            (app.tr("ui.plugin_holes_hint"), StatusTone::Dim)
+        } else {
+            match &self.preview {
+                Some(Ok(preview)) => (preview.label.as_str(), StatusTone::Dim),
+                Some(Err(error)) => (error.as_str(), StatusTone::Warning),
+                None => (app.tr("ui.plugin_holes_checking"), StatusTone::Dim),
+            }
+        };
+        ui_kit::status_line(ui, text, tone);
+    }
+}
+
+// This is only a pick filter. The plugin checks concavity, fit and the completed cut.
+fn rim(body: &kernel::Body, index: usize) -> Option<(kernel::EdgeCircle, Vec3)> {
+    use solidcore_record::brep::Surface;
+    let record = body.record();
+    let uses = &record.edges.get(index)?.uses;
+    let wall =
+        uses.iter().find(|usage| record.faces.get(usage.face as usize).is_some_and(|face| matches!(face.surface, Surface::Cylinder { .. })))?;
+    let FaceSurface::Cylinder { axis, .. } = kernel::face_surface(body, wall.face as usize)? else { return None };
+    let normal = uses.iter().find_map(|usage| {
+        let face = usage.face as usize;
+        if record.faces.get(face)?.loops.len() < 2 {
+            return None;
+        }
+        match kernel::face_surface(body, face)? {
+            FaceSurface::Plane { normal, .. } if normal.dot(*axis).abs() > 0.99999 => Some(*normal),
+            _ => None,
+        }
+    })?;
+    let circle = kernel::edge_circle(body, index)?;
+    Some((circle, normal))
+}
+
+fn target(app: &SolveApp, proj: &Proj, at: Pos2, hits: &[Hit]) -> Option<Target> {
+    let world = crate::open_meshing::shown_world(app);
+    let (_, ray) = proj.ray(at);
+    hits.iter().find_map(|hit| {
+        let Hit::Edge { body, index, .. } = hit else { return None };
+        let (_, normal) = rim(&world.body(body)?.body, *index)?;
+        (normal.dot(ray) < -1e-5).then(|| Target { body: body.clone(), edge: *index })
+    })
+}
+
+impl Preview {
+    fn new(edit: ComputedCommands, invalid: &str, locale: solidcraft_ui_text::Locale) -> Result<Self, String> {
+        let missing = || invalid.to_owned();
+        let result = edit.last_reply().and_then(|reply| reply.get("result")).ok_or_else(missing)?;
+        let rows = result["sedi"].as_array().filter(|rows| !rows.is_empty()).ok_or_else(missing)?;
+        let seats = rows.iter().map(|row| Seat::new(row, missing)).collect::<Result<Vec<_>, _>>()?;
+        let count = seats.len().to_string();
+        let label = locale.format("ui.plugin_holes_ready", &[("count", &count)]);
+        let meshes = seats.iter().map(|seat| seat.cut_volume().map_err(|error| format!("{invalid} {error}"))).collect::<Result<Vec<_>, _>>()?;
+        let bounds = meshes.iter().fold(Aabb3::EMPTY, |bounds, mesh| bounds.union(&mesh.bounds()));
+        Ok(Self { edit, seats, meshes, bounds, key: NEXT_SCENE.fetch_add(1, Ordering::Relaxed), label })
+    }
+}
+
+impl Seat {
+    fn new(row: &Value, invalid: impl Fn() -> String + Copy) -> Result<Self, String> {
+        let number = |key: &str| row[key].as_f64().filter(|value| value.is_finite() && *value > 0.0).ok_or_else(invalid);
+        let center = params::vec3(&row["centro_mm"]).ok_or_else(invalid)?;
+        let normal = params::vec3(&row["normale"]).and_then(|normal| normal.normalized()).ok_or_else(invalid)?;
+        Ok(Self {
+            center,
+            normal,
+            pilot_radius: number("diametro_attuale_mm")? / 2.0,
+            pilot_depth: number("profondita_cilindrica_attuale_mm")?,
+            radius: number("diametro_sede_mm")? / 2.0,
+            depth: number("profondita_sede_mm")?,
+        })
+    }
+
+    /// Revolve the material inside the seat diameter and outside the existing pilot.
+    /// A blind pilot that ends inside the seat leaves a solid disk below its floor.
+    fn cut_volume(&self) -> Result<Mesh, String> {
+        let pilot_end = self.pilot_depth.min(self.depth);
+        let mut section = vec![Vec2::new(self.pilot_radius, 0.0), Vec2::new(self.radius, 0.0), Vec2::new(self.radius, self.depth)];
+        if pilot_end < self.depth {
+            section.extend([Vec2::new(0.0, self.depth), Vec2::new(0.0, pilot_end)]);
+        }
+        section.push(Vec2::new(self.pilot_radius, pilot_end));
+        let region = Region2 { outer: Loop2::polygon(&section), holes: Vec::new() };
+        let plane = Plane { origin: self.center, x: self.normal.any_perp(), y: -self.normal };
+        let tool = kernel::revolve(&plane, &[region], Vec2::ZERO, Vec2::Y, std::f64::consts::TAU)
+            .map_err(|error| error.to_string())?
+            .pop()
+            .ok_or_else(|| "No cut volume".to_owned())?;
+        tool.mesh(&kernel::MeshTolerance::chord(0.01)).map_err(|error| error.to_string())
+    }
+
+    fn paint_dimensions(&self, app: &SolveApp, painter: &Painter, proj: &Proj, labels: &mut Vec<Rect>) {
+        if crate::viewport::section_plane(app).is_some_and(|(origin, normal)| normal.dot(self.center - origin) > 0.0) {
+            return;
+        }
+        let Some(anchor) = proj.to_screen(self.center) else { return };
+        let t = Tokens::get();
+        let units = &app.session.doc.units;
+        let decimals = app.preferences.length_decimals;
+        let diameter = crate::prefs::length_number(self.radius * 2.0, units, decimals);
+        let depth = crate::prefs::format_length(self.depth, units, decimals);
+        let galley = painter.layout_no_wrap(format!("Ø{diameter} × {depth}"), egui::FontId::proportional(t.font_small), t.text);
+        let padding = vec2(t.space_6, t.space_4);
+        let size = galley.size() + padding * 2.0;
+        let clip = painter.clip_rect();
+        let offsets = [
+            vec2(t.space_24, -size.y - t.space_12),
+            vec2(-size.x - t.space_24, -size.y - t.space_12),
+            vec2(t.space_24, t.space_12),
+            vec2(-size.x - t.space_24, t.space_12),
+        ];
+        if let Some(rect) = offsets
+            .into_iter()
+            .map(|offset| Rect::from_min_size(anchor + offset, size))
+            .find(|rect| clip.contains_rect(*rect) && !labels.iter().any(|other| other.intersects(*rect)))
+        {
+            let end = egui::pos2(anchor.x.clamp(rect.left(), rect.right()), anchor.y.clamp(rect.top(), rect.bottom()));
+            painter.line_segment([anchor, end], Stroke::new(1.0, t.preview_cut.to_opaque()));
+            painter.rect_filled(rect, t.radius_sm, t.panel);
+            painter.galley(rect.min + padding, galley, t.text);
+            labels.push(rect);
+        }
+    }
+}
