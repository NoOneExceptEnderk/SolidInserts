+//! Select hole rims and preview one SolidInserts transaction. Run accepts the
+//! prepared edit only if it still matches the design and the form inputs.
+
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Arc, mpsc};
+use std::time::Duration;
+
+use egui::{Context, Painter, Pos2, Rect, Stroke, Ui, vec2};
+use serde_json::{Value, json};
+use solidcore_record::{Loop2, Plane, Region2, Vec2, Vec3};
+use solidcraft_engine::doc::progress::{self, Progress};
+use solidcraft_engine::geom::prelude::*;
+use solidcraft_engine::geom::{Aabb3, Mesh};
+use solidcraft_engine::kernel::{self, FaceSurface};
+use solidcraft_engine::{ComputedCommands, params};
+use solidcraft_theme::Tokens;
+
+use crate::SolveApp;
+use crate::plugin_menu::EntryDialog;
+use crate::ui_kit::{self, StatusTone};
+use crate::viewport::{Hit, Proj};
+
+const MAX_HOLES: usize = 24;
+const PLUGIN_RUN: &str = "plugin.run";
+static NEXT_SCENE: AtomicU64 = AtomicU64::new(0);
+
+#[derive(PartialEq)]
+struct Target {
+    body: String,
+    edge: usize,
+}
