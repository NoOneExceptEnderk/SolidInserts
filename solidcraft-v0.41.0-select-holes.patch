+pub(crate) fn preview_meshes(app: &SolveApp) -> Option<(u64, &[Mesh], Aabb3)> {
+    if !can_pick(app) {
+        return None;
+    }
+    let dialog = app.plugin_menu.dialog.as_ref()?;
+    let mode = dialog.holes.as_ref()?;
+    if !mode.ready(app, &dialog.ready(app).ok()?) {
+        return None;
+    }
+    let preview = mode.preview.as_ref()?.as_ref().ok()?;
+    Some((preview.key, &preview.meshes, preview.bounds))
+}
+
+fn prepare(app: &mut SolveApp, ctx: &Context, dialog: &EntryDialog, mut input: Value, targets: &[Target]) -> Result<Pending, String> {
+    let world = crate::open_meshing::shown_world(app);
+    let changed = || app.tr("ui.plugin_context_changed").to_owned();
+    let picks = targets
+        .iter()
+        .map(|target| {
+            let body = world.body(&target.body).ok_or_else(changed)?;
+            let circle = kernel::edge_circle(&body.body, target.edge).ok_or_else(changed)?;
+            let point = circle.start;
+            Ok(json!({"type":"edge","body":target.body,"index":target.edge,"point":[point.x, point.y, point.z]}))
+        })
+        .collect::<Result<Vec<_>, String>>()?;
+    input["hole_picks"] = json!(picks);
+    let request = dialog.call(input);
+    crate::plugins::sync_policy(app);
+    let copy = app.session.scratch();
+    let invalid = app.tr("ui.plugin_no_result").to_owned();
+    let locale = solidcraft_ui_text::Locale::for_language(&app.preferences.language);
+    let quality = solidcraft_engine::doc::display_quality::current();
+    let progress = Arc::new(Progress::default());
+    let watch = progress.clone();
+    let ctx = ctx.clone();
+    let (send, reply) = mpsc::channel();
+    std::thread::Builder::new()
+        .name("solidinserts-preview".into())
+        .spawn(move || {
+            let result = progress::watch(watch.clone(), || {
+                let edit = copy.compute_commands(&[(PLUGIN_RUN.into(), request)], None).map_err(|err| {
+                    let text = err.to_string();
+                    text.strip_prefix("plugin: invalid input SolidInserts: ").unwrap_or(&text).to_owned()
+                })?;
+                crate::control_job::warm_plugin_display(&edit, quality, &watch).map_err(|err| err.to_string())?;
+                Preview::new(edit, &invalid, locale)
+            });
+            let _ = send.send(result);
+            ctx.request_repaint();
+        })
+        .map_err(|_| app.tr("ui.plugin_start_failed").to_owned())?;
+    Ok(Pending { progress, reply })
+}
+
+pub(crate) fn viewport(app: &mut SolveApp, painter: &Painter, proj: &Proj, at: Option<Pos2>, hits: &[Hit], click: bool, extend: bool) {
+    if app.plugin_menu.dialog.as_ref().is_none_or(|dialog| dialog.holes.is_none()) {
+        return;
+    }
+    let Some(mut dialog) = app.plugin_menu.dialog.take() else { return };
+    if let Some(mut mode) = dialog.holes.take()
+        && mode.in_design(app)
+    {
+        let input = dialog.ready(app).ok();
+        let ctx = painter.ctx();
+        mode.poll(app.tr("ui.plugin_no_result"), ctx);
+        mode.sync(app, input.as_ref());
+        if can_pick(app) {
+            if mode.picking
+                && let Some(target) = at.and_then(|at| target(app, proj, at, hits))
+            {
+                ctx.set_cursor_icon(egui::CursorIcon::PointingHand);
+                if click {
+                    dialog.error = mode.select(target, extend, app.tr("ui.plugin_holes_limit")).err();
+                    ctx.request_repaint();
+                }
+            }
+            if let Some(input) = input
+                && !mode.selected.is_empty()
+                && mode.preview.is_none()
+                && mode.pending.is_none()
+            {
+                match prepare(app, ctx, &dialog, input, &mode.selected) {
+                    Ok(pending) => mode.pending = Some(pending),
+                    Err(error) => mode.preview = Some(Err(error)),
+                }
+            }
+            if let Some(Ok(preview)) = &mode.preview {
+                let mut labels = Vec::new();
+                for seat in &preview.seats {
+                    seat.paint_dimensions(app, painter, proj, &mut labels);
+                }
+            }
+        }
+        if mode.pending.is_some() {
+            ctx.request_repaint_after(Duration::from_millis(100));
+        }
+        dialog.holes = Some(mode);
+    }
+    app.plugin_menu.dialog = Some(dialog);
+}
+
+pub(crate) fn run(app: &mut SolveApp, dialog: &mut EntryDialog) -> Result<(), String> {
+    let input = dialog.ready(app)?;
+    crate::plugins::sync_policy(app);
+    let Some(mode) = dialog.holes.as_mut() else { return Err(app.tr("ui.plugin_holes_hint").into()) };
+    if !mode.ready(app, &input) {
+        return Err(app.tr("ui.plugin_context_changed").into());
+    }
+    let Some(Ok(preview)) = mode.preview.take() else { return Err(app.tr("ui.plugin_no_result").into()) };
+    accept(app, preview)
+}
+
+fn accept(app: &mut SolveApp, preview: Preview) -> Result<(), String> {
+    if app.control_job.is_some() || app.saving.is_some() || !preview.edit.is_current(&app.session) {
+        return Err(app.tr("ui.plugin_context_changed").to_owned());
+    }
+    let replies = app.session.accept_commands(preview.edit).map_err(|error| error.to_string())?;
+    if let Some((_, reply)) = replies.into_iter().last() {
+        if let Some(exits) = reply.get("sketch_exits").and_then(Value::as_array) {
+            for sketch in exits {
+                app.sketch_closed(sketch.as_u64());
+            }
+        }
+        app.command_completed(PLUGIN_RUN, Ok(reply))?;
+    }
+    app.set_status(app.tr("ui.plugin_holes_applied"), false);
+    Ok(())
+}
+
+pub(crate) fn cancel_on_escape(app: &mut SolveApp, ctx: &Context) -> bool {
+    if app.viewport.nav.is_some() || !active(app) || !ctx.input_mut(|input| input.consume_key(egui::Modifiers::NONE, egui::Key::Escape)) {
+        return false;
+    }
+    if let Some(dialog) = app.plugin_menu.dialog.as_mut() {
+        dialog.holes = None;
+        dialog.error = None;
+    }
+    app.esc_handled = true;
+    app.last_escape = None;
+    true
+}
